# ──────────────────────────────────────────────
# FinOps Dashboard — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Google Cloud / BigQuery
GCP_PROJECT_ID=your-gcp-project-id
GCP_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
BQ_DATASET=your_dataset
BQ_TABLE=your_billing_export_table

# Anthropic AI — required, app will not start without this
ANTHROPIC_API_KEY=sk-ant-...

# Redis — optional, caching is disabled if not set
REDIS_URL=redis://localhost:6379

# Logging — optional, defaults to info
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Runtime — optional, defaults to development
# development | test | production
NODE_ENV=development

# Deployment tier — distinguishes staging from production at runtime
# (NODE_ENV only supports development | test | production, not staging)
# development | staging | production
DEPLOY_ENV=development

# FastAPI backend URL — Next.js UI calls this service for data
# Local dev: http://localhost:8000
# Docker: http://localhost:8000 (browser calls the exposed port)
# Leave empty to fall back to the built-in Next.js /api/bigquery route
NEXT_PUBLIC_API_URL=http://localhost:8000
